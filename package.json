{
  "name": "@nagaai/openclaw-provider",
  "version": "0.1.0",
  "description": "OpenClaw provider plugin for NagaAI, an OpenAI-compatible API for models from many labs.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "openclaw-provider",
    "nagaai",
    "llm"
  ],
  "homepage": "https://docs.naga.ac/integrations/agents/openclaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naga-ai-hub/openclaw-provider-nagaai.git"
  },
  "bugs": {
    "url": "https://github.com/naga-ai-hub/openclaw-provider-nagaai/issues"
  },
  "license": "MIT",
  "author": "NagaAI <support@naga.ac>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "files": [
    "dist",
    "assets",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "npm run build && clawhub package validate . --out .clawhub-validation",
    "check": "npm run typecheck && npm run test && npm run validate",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "clawhub": "0.25.1",
    "openclaw": "2026.11.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "providers": [
      "nagaai"
    ],
    "install": {
      "clawhubSpec": "clawhub:@nagaai/openclaw-provider",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.11.2"
    },
    "compat": {
      "pluginApi": ">=2026.11.2",
      "minGatewayVersion": "2026.11.2"
    },
    "build": {
      "openclawVersion": "2026.11.2",
      "pluginSdkVersion": "2026.11.2"
    }
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "pluginInspector": {
    "version": 1,
    "plugin": {
      "id": "nagaai",
      "priority": "high",
      "seams": [
        "plugin-runtime"
      ],
      "sourceRoot": ".",
      "expect": {
        "registrations": [
          "registerProvider",
          "registerModelCatalogProvider"
        ]
      }
    }
  }
}
